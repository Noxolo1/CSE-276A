<?xml version="1.0"?>
<package format="3">
  <name>hw5_coverage</name>
  <version>0.0.0</version>
  <description>CSE 276A HW5 coverage / Roomba-style controller</description>

  <maintainer email="new002@ucsd.edu">nate wilson</maintainer>
  <license>MIT</license>

  <!-- Core dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- We just launch these from this package; keeping them as run deps is fine -->
  <exec_depend>robot_control</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>robot_vision_camera</exec_depend>
  <exec_depend>hw4_planning</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
